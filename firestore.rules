rules_version = '2';

// 캔트 스탑 · 모둠 동시 대전판 — Firestore 보안 규칙
// 태블릿·전자칠판은 익명 로그인으로 접속합니다. rooms 컬렉션과 그 아래 teams만 읽고 쓸 수 있어요.
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && code.matches('^[A-Z]{4}$')
        && request.resource.data.code == code
        && request.resource.data.v == 2
        && request.resource.data.status in ['lobby', 'playing', 'finished']
        && request.resource.data.teams is list
        && request.resource.data.teams.size() <= 10
        && request.resource.data.keys().hasOnly([
          'v', 'code', 'hostId', 'status', 'settings', 'teams', 'game', 'round', 'phase', 'deadline', 'paused',
          'pieces', 'claimed', 'flags', 'stats', 'reveal', 'log', 'createdAt', 'updatedAt'
        ]);

      allow delete: if false;

      // 모둠별 라운드 문서 (주사위·퀴즈·선택)
      match /teams/{teamId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.id == teamId
          && request.resource.data.keys().hasOnly(['id', 'game', 'round', 'dice', 'quiz', 'decision', 'updatedAt'])
          && exists(/databases/$(database)/documents/rooms/$(code));
        allow delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
